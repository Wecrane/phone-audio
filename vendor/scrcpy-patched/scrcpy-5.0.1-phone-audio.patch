+        if (!sc_audio_player_find_device(ap->output_device_name, &device)) {
+            LOGE("Audio output device not found: %s",
+                 ap->output_device_name);
+            LOGE("List the available devices with --list-audio-devices");
+            free(ap->aout_buffer);
