+bool
+sc_audio_player_list_devices(void) {
+    if (!SDL_Init(SDL_INIT_AUDIO)) {
+        LOGE("Could not initialize SDL audio: %s", SDL_GetError());
+        return false;
+    }
+
+    int count;
+    SDL_AudioDeviceID *devices = SDL_GetAudioPlaybackDevices(&count);
+    if (!devices) {
+        LOGE("Could not list audio output devices: %s", SDL_GetError());
+        SDL_Quit();
+        return false;
+    }
+
+    for (int i = 0; i < count; ++i) {
+        const char *name = SDL_GetAudioDeviceName(devices[i]);
+        if (name) {
+            printf("%s\n", name);
+        }
+    }
+
+    SDL_free(devices);
+    SDL_Quit();
+    return true;
+}
+
+static bool
+sc_audio_player_find_device(const char *name, SDL_AudioDeviceID *device) {
+    int count;
+    SDL_AudioDeviceID *devices = SDL_GetAudioPlaybackDevices(&count);
+    if (!devices) {
+        return false;
+    }
+
+    bool found = false;
+    for (int i = 0; i < count; ++i) {
+        const char *device_name = SDL_GetAudioDeviceName(devices[i]);
+        if (device_name && !strcmp(device_name, name)) {
+            *device = devices[i];
+            found = true;
+            break;
+        }
+    }
+
+    SDL_free(devices);
+    return found;
+}
